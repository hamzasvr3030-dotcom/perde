<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mw_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:orientation="horizontal" android:gravity="center_vertical" android:padding="12dp">
    <ImageView android:id="@+id/mw_art" android:layout_width="96dp" android:layout_height="96dp"
        android:background="@drawable/widget_art_bg" android:scaleType="centerCrop" android:clipToOutline="true"
        android:src="@drawable/ic_launcher_foreground" android:contentDescription="Kapak" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:layout_marginStart="14dp" android:orientation="vertical">
        <TextView android:id="@+id/mw_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:singleLine="true" android:ellipsize="end" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" android:text="Kadraj" />
        <TextView android:id="@+id/mw_artist" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:singleLine="true" android:ellipsize="end" android:textColor="#B4B7C0" android:textSize="13sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
            android:gravity="center_vertical" android:orientation="horizontal">
            <ImageButton android:id="@+id/mw_prev" android:layout_width="44dp" android:layout_height="44dp"
                android:background="@android:color/transparent" android:src="@drawable/ic_prev" android:contentDescription="Önceki" />
            <ImageButton android:id="@+id/mw_play" android:layout_width="52dp" android:layout_height="52dp" android:layout_marginStart="8dp" android:layout_marginEnd="8dp"
                android:background="@drawable/widget_btn_blue" android:src="@drawable/ic_play" android:contentDescription="Oynat" />
            <ImageButton android:id="@+id/mw_next" android:layout_width="44dp" android:layout_height="44dp"
                android:background="@android:color/transparent" android:src="@drawable/ic_next" android:contentDescription="Sonraki" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
