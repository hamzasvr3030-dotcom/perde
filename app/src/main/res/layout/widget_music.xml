<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mw_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:clipToOutline="true">
    <ImageView android:id="@+id/mw_bg" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="centerCrop" android:alpha="0.28" android:importantForAccessibility="no" />
    <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_shade" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
        android:padding="14dp" android:gravity="center_vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/mw_art" android:layout_width="62dp" android:layout_height="62dp"
                android:background="@drawable/widget_art_bg" android:scaleType="centerCrop" android:clipToOutline="true"
                android:src="@drawable/ic_launcher_foreground" android:contentDescription="Kapak" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="12dp" android:orientation="vertical">
                <TextView android:id="@+id/mw_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:singleLine="true" android:ellipsize="end" android:textColor="#FFFFFF" android:textSize="17sp" android:textStyle="bold" android:text="Kadraj" />
                <TextView android:id="@+id/mw_artist" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:singleLine="true" android:ellipsize="end" android:textColor="#CCFFFFFF" android:textSize="13sp" />
                <TextView android:id="@+id/mw_next_t" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp"
                    android:singleLine="true" android:ellipsize="end" android:textColor="#99FFFFFF" android:textSize="11sp" />
            </LinearLayout>
            <ImageButton android:id="@+id/mw_fav" android:layout_width="40dp" android:layout_height="40dp"
                android:background="@android:color/transparent" android:src="@drawable/ic_heart" android:contentDescription="Favori" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
            android:orientation="horizontal" android:gravity="center_vertical">
            <ImageButton android:id="@+id/mw_shuffle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp"
                android:background="@android:color/transparent" android:src="@drawable/ic_shuffle" android:contentDescription="Karıştır" />
            <ImageButton android:id="@+id/mw_prev" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp"
                android:background="@android:color/transparent" android:src="@drawable/ic_prev" android:scaleType="center" android:contentDescription="Önceki" />
            <ImageButton android:id="@+id/mw_play" android:layout_width="58dp" android:layout_height="58dp" android:layout_marginStart="4dp" android:layout_marginEnd="4dp"
                android:background="@drawable/widget_btn_white" android:src="@drawable/ic_play_dark" android:contentDescription="Oynat" />
            <ImageButton android:id="@+id/mw_next" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp"
                android:background="@android:color/transparent" android:src="@drawable/ic_next" android:scaleType="center" android:contentDescription="Sonraki" />
            <ImageButton android:id="@+id/mw_repeat" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp"
                android:background="@android:color/transparent" android:src="@drawable/ic_repeat" android:contentDescription="Tekrar" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
